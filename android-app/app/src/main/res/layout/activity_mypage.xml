<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@color/background"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 녹색 헤더 배경 (레벨/EXP 영역까지 포함하도록 높이 확장: 320→400dp) -->
            <View
                android:id="@+id/topBackground"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:background="@color/button"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 마이페이지 타이틀 -->
            <TextView
                android:id="@+id/tvMypageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="48dp"
                android:text="@string/mypage_title"
                android:fontFamily="@font/pretendardbold"
                android:textColor="@color/white"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 편집 버튼 -->
            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/edit"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/pretendardmedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvMypageTitle"
                app:layout_constraintBottom_toBottomOf="@id/tvMypageTitle" />

            <!-- 중앙 프로필 이미지 (큰 원형) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/tvMypageTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_placeholder" />
            </androidx.cardview.widget.CardView>

            <!-- 사용자 이름 -->
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                tools:text="홍길동"
                android:textColor="@color/white"
                android:fontFamily="@font/pretendardsemibold"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/cardProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- @핸들 표시 -->
            <TextView
                android:id="@+id/tvUserHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="visible"
                tools:text="@user"
                android:fontFamily="@font/pretendardlight"
                android:textColor="#B2FFFFFF"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/tvUserName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 레벨 칭호 -->
            <TextView
                android:id="@+id/tvLevelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="식물 탐험가 Lv.3"
                android:fontFamily="@font/pretendardsemibold"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvUserHandle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 레벨 프로그레스바 (5-segment) -->
            <LinearLayout
                android:id="@+id/llLevelProgress"
                android:layout_width="200dp"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:weightSum="5"
                app:layout_constraintTop_toBottomOf="@id/tvLevelTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/lvSegment1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:background="#80FFFFFF" />
                <View
                    android:id="@+id/lvSegment2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="#40FFFFFF" />
                <View
                    android:id="@+id/lvSegment3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="#40FFFFFF" />
                <View
                    android:id="@+id/lvSegment4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="#40FFFFFF" />
                <View
                    android:id="@+id/lvSegment5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:background="#40FFFFFF" />
            </LinearLayout>

            <!-- EXP 텍스트 -->
            <TextView
                android:id="@+id/tvExpProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="EXP 30 / 50"
                android:fontFamily="@font/pretendardlight"
                android:textColor="#B2FFFFFF"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/llLevelProgress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 최근 본 식물 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecentPlants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-30dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/topBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 최근 본 식물 헤더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@color/button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/recent_viewed_plants"
                            android:textColor="@color/text1"
                            android:textSize="16sp"
                            android:fontFamily="@font/pretendardsemibold" />
                    </LinearLayout>

                    <!-- 최근 본 식물 ViewPager -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpRecentPlants"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:clipToPadding="false" />

                    <!-- 최근 본 식물이 없을 때 메시지 -->
                    <TextView
                        android:id="@+id/tvNoRecentPlants"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:text="@string/no_recent_plants"
                        android:textColor="@color/sub_text1"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendardmedium"
                        android:visibility="gone" />

                    <!-- 슬라이드 인디케이터 (4칸) -->
                    <LinearLayout
                        android:id="@+id/slideIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <View
                            android:id="@+id/indicator1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="2dp"
                            android:background="@color/button" />

                        <View
                            android:id="@+id/indicator2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:background="#E0E0E0" />

                        <View
                            android:id="@+id/indicator3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:background="#E0E0E0" />

                        <View
                            android:id="@+id/indicator4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="2dp"
                            android:background="#E0E0E0" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 발견한 식물 / 탐험 기록 카드 -->
            <LinearLayout
                android:id="@+id/llStatCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@id/cardRecentPlants">

                <!-- 발견한 식물 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/discovered_plants"
                            android:textColor="@color/sub_text1"
                            android:textSize="12sp"
                            android:fontFamily="@font/pretendardmedium" />

                        <TextView
                            android:id="@+id/tvDiscoveredCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="12종"
                            android:textColor="@color/button"
                            android:textSize="20sp"
                            android:fontFamily="@font/pretendardbold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 탐험 기록 카드 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/explore_records"
                            android:textColor="@color/sub_text1"
                            android:textSize="12sp"
                            android:fontFamily="@font/pretendardmedium" />

                        <TextView
                            android:id="@+id/tvViewedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="25회"
                            android:textColor="@color/button"
                            android:textSize="20sp"
                            android:fontFamily="@font/pretendardbold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 계정 메뉴 (숨김 처리 - 필요시 표시) -->
            <LinearLayout
                android:id="@+id/llAccountMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/llStatCards">

                <Button
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/change_password"
                    android:backgroundTint="@color/button"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/logout"
                    android:backgroundTint="@color/background"
                    android:textColor="@color/text1" />

                <Button
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/delete_account"
                    android:backgroundTint="#F44336"
                    android:textColor="@color/white" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 헤더 (숨김) -->
    <include
        android:id="@+id/fixedHeader"
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 통일된 푸터바 (view_bottom_navigation.xml) -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
